                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Uid="Nav_Lighting"
                    Tag="lighting"
                    Visibility="{x:Bind Shell.LightingAvailable, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_System" Tag="system">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="36,8,36,0">
                    <!-- Update available (closing it means "later") -->
                    <InfoBar
                        Title="{x:Bind Updates.BannerTitle, Mode=OneWay}"
                        Margin="0,0,0,8"
                        IsOpen="{x:Bind Updates.BannerOpen, Mode=TwoWay}"
                        Message="{x:Bind Updates.BannerMessage, Mode=OneWay}"
                        Severity="Informational">
                        <InfoBar.ActionButton>
                            <Button
                                x:Uid="Update_Install"
                                Command="{x:Bind Updates.InstallCommand}"
                                Style="{StaticResource AccentButtonStyle}" />
                        </InfoBar.ActionButton>
                        <StackPanel Margin="0,0,0,12" Spacing="4">
                            <ProgressBar
                                Maximum="1"
                                Visibility="{x:Bind Updates.IsDownloading, Mode=OneWay}"
                                Value="{x:Bind Updates.DownloadProgress, Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <HyperlinkButton x:Uid="Update_WhatsNew" Command="{x:Bind Updates.OpenReleasePageCommand}" />
                                <HyperlinkButton x:Uid="Update_Skip" Command="{x:Bind Updates.SkipCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </InfoBar>
                    <ItemsControl ItemsSource="{x:Bind Shell.Notices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:Notice">
                                <InfoBar
                                    Title="{x:Bind Title}"
                                    Margin="0,0,0,8"
                                    CloseButtonClick="OnNoticeClosed"
                                    IsOpen="True"
                                    Message="{x:Bind Message}"
                                    Severity="{x:Bind Severity}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>

        <!-- Startup -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{x:Bind Shell.IsStarting, Mode=OneWay}">
            <ProgressRing Width="48" Height="48" IsActive="True" />
            <TextBlock x:Uid="Startup_Connecting" Style="{StaticResource BodyTextBlockStyle}" />
        </StackPanel>

        <!-- Problems -->
        <StackPanel
            Grid.Row="1"
            MaxWidth="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind Shell.ShowProblem, Mode=OneWay}">
            <Image Width="72" Height="72" Source="ms-appx:///Assets/OpenSense.png" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind Shell.ProblemTitle, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind Shell.ProblemMessage, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <StackPanel
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Uid="Problem_RestartElevated"
                    Command="{x:Bind Shell.RetryElevationCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind Shell.CanRetryElevation, Mode=OneWay}" />
                <Button
                    x:Uid="Problem_StartService"
                    Command="{x:Bind Shell.StartServiceCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind Shell.CanStartService, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!-- OpenSense accent (the icon's red-orange), tuned for dark surfaces. -->
            <Color x:Key="SystemAccentColor">#FF5A4E</Color>
            <Color x:Key="SystemAccentColorLight1">#FF7466</Color>
            <Color x:Key="SystemAccentColorLight2">#FF8E80</Color>
            <Color x:Key="SystemAccentColorLight3">#FFB3A9</Color>
            <Color x:Key="SystemAccentColorDark1">#E4473C</Color>
            <Color x:Key="SystemAccentColorDark2">#C13A31</Color>
            <Color x:Key="SystemAccentColorDark3">#9E2E27</Color>

            <SolidColorBrush x:Key="GaugeTrackBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="ChartGridBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="ZoneOffBrush" Color="#26FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SystemAccentColor">#E4473C</Color>
            <Color x:Key="SystemAccentColorLight1">#F0584C</Color>
            <Color x:Key="SystemAccentColorLight2">#FF7466</Color>
            <Color x:Key="SystemAccentColorLight3">#FF9D92</Color>
            <Color x:Key="SystemAccentColorDark1">#CC3D33</Color>
            <Color x:Key="SystemAccentColorDark2">#AD3129</Color>
            <Color x:Key="SystemAccentColorDark3">#8C2620</Color>

            <SolidColorBrush x:Key="GaugeTrackBrush" Color="#18000000" />
            <SolidColorBrush x:Key="ChartGridBrush" Color="#12000000" />
            <SolidColorBrush x:Key="ZoneOffBrush" Color="#1A000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="GaugeTrackBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="ChartGridBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="ZoneOffBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Temperature scale shared by gauges, graphs and the tray icon. -->
    <Color x:Key="TemperatureCoolColor">#3DB8F5</Color>
    <Color x:Key="TemperatureWarmColor">#3DD68C</Color>
    <Color x:Key="TemperatureHotColor">#FFB224</Color>
    <Color x:Key="TemperatureCriticalColor">#FF4D4D</Color>

    <x:Double x:Key="PageMaxWidth">1180</x:Double>
    <Thickness x:Key="PagePadding">36,20,36,36</Thickness>
    <x:Double x:Key="SectionSpacing">24</x:Double>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="1,24,0,8" />
    </Style>

    <Style x:Key="CaptionMutedStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="BigNumberStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="44" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="CharacterSpacing" Value="-20" />
    </Style>

    <Style x:Key="TileValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="CharacterSpacing" Value="-10" />
        <Setter Property="LineHeight" Value="40" />
    </Style>
</ResourceDictionary>

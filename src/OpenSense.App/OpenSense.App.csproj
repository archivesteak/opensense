<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>OpenSense.App</RootNamespace>
    <AssemblyName>OpenSense</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\OpenSense.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$(Platform.ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Unpackaged, self-contained: the installer ships the Windows App SDK runtime with the app. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Required even when unpackaged: generates the app's resources.pri and publishes compiled XAML (.xbf). -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Program.Main handles single-instance activation and (portable copy only) elevation before WinUI starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="H.NotifyIcon.WinUI" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <!--
    The toolkit libraries depend on the Microsoft.WindowsAppSDK metapackage, which also brings the
    ML (ONNX Runtime, DirectML), AI, Search and Widgets components. OpenSense uses none of them, so
    their assets are excluded instead of shipping ~50 MB of unused runtimes.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" ExcludeAssets="all" />
  </ItemGroup>

  <!-- The Windows API projection is large and OpenSense calls a sliver of it; precompiling it all would double its size for nothing. -->
  <ItemGroup>
    <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenSense.Core\OpenSense.Core.csproj" />
  </ItemGroup>

  <!-- Where to look for updates, from Directory.Build.props. -->
  <ItemGroup>
    <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The Windows App SDK 2.x component packages leave out Microsoft.WindowsAppRuntime.Insights.Resource.dll, which holds
    the runtime's version information. Without it the runtime's self-contained check fails, and with it
    AppNotificationManager.Register ("The specified module could not be found", microsoft/WindowsAppSDK#6071). The file
    ships in the SDK's own framework package, so it is taken from there, for the same SDK version and architecture.
    Remove this once a Microsoft.WindowsAppSDK.Foundation release contains microsoft/WindowsAppSDK#6725.
  -->
  <Target Name="AddWindowsAppRuntimeVersionInfo" BeforeTargets="AssignTargetPaths">
    <PropertyGroup>
      <WindowsAppRuntimeFrameworkMsix>$(MicrosoftWindowsAppSDKPackageDir)tools\MSIX\win10-$(Platform.ToLowerInvariant())\Microsoft.WindowsAppRuntime.2.msix</WindowsAppRuntimeFrameworkMsix>
      <WindowsAppRuntimeVersionInfoDirectory>$(IntermediateOutputPath)WindowsAppRuntime\</WindowsAppRuntimeVersionInfoDirectory>
    </PropertyGroup>
    <Error Condition="!Exists('$(WindowsAppRuntimeFrameworkMsix)')" Text="Windows App SDK framework package not found: $(WindowsAppRuntimeFrameworkMsix)" />
    <Unzip SourceFiles="$(WindowsAppRuntimeFrameworkMsix)" DestinationFolder="$(WindowsAppRuntimeVersionInfoDirectory)"
           Include="Microsoft.WindowsAppRuntime.Insights.Resource.dll" SkipUnchangedFiles="true" />
    <ItemGroup>
      <None Include="$(WindowsAppRuntimeVersionInfoDirectory)Microsoft.WindowsAppRuntime.Insights.Resource.dll"
            Link="Microsoft.WindowsAppRuntime.Insights.Resource.dll"
            CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>

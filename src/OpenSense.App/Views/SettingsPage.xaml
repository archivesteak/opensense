                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.OpenWithNitroSenseKey, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <!-- Click, then press the key or combination; Esc cancels -->
            <toolkit:SettingsCard
                x:Uid="Settings_OpenShortcut"
                Description="{x:Bind ViewModel.ShortcutHelp, Mode=OneWay}"
                HeaderIcon="{ui:FontIcon Glyph=&#xEDA7;}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        MinWidth="140"
                        Command="{x:Bind ViewModel.RecordShortcutCommand}"
                        Content="{x:Bind ViewModel.ShortcutText, Mode=OneWay}"
                        LostFocus="OnShortcutLostFocus" />
                    <Button
                        x:Uid="Settings_ShortcutClear"
                        Command="{x:Bind ViewModel.ClearShortcutCommand}"
                        Visibility="{x:Bind ViewModel.HasShortcut, Mode=OneWay}">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </StackPanel>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Uid="Settings_CloseToTray" HeaderIcon="{ui:FontIcon Glyph=&#xE89F;}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <TextBlock x:Uid="Settings_Appearance" Style="{StaticResource SectionHeaderStyle}" />
            <toolkit:SettingsCard x:Uid="Settings_Language" HeaderIcon="{ui:FontIcon Glyph=&#xF2B7;}">
                <ComboBox
                    MinWidth="200"
                    ItemsSource="{x:Bind vm:SettingsViewModel.Languages}"
                    SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <!-- Each name in its own language, so the right font and glyph forms are used. -->
                        <DataTemplate x:DataType="loc:LanguageOption">
                            <TextBlock Language="{x:Bind local:SettingsPage.TextLanguage(Tag)}" Text="{x:Bind NativeName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </toolkit:SettingsCard>
            <InfoBar
                x:Uid="Settings_LanguageRestart"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.LanguageRestartNeeded, Mode=OneWay}"
                Severity="Informational">
                <InfoBar.ActionButton>
                    <Button x:Uid="Settings_LanguageRestartNow" Command="{x:Bind ViewModel.RestartCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <toolkit:SettingsCard x:Uid="Settings_Theme" HeaderIcon="{ui:FontIcon Glyph=&#xE790;}">
                <ComboBox
                    MinWidth="200"
                    ItemsSource="{x:Bind vm:SettingsViewModel.ThemeNames}"
                    SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Uid="Settings_Fahrenheit" HeaderIcon="{ui:FontIcon Glyph=&#xE9CA;}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.UseFahrenheit, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <TextBlock x:Uid="Settings_Laptop" Style="{StaticResource SectionHeaderStyle}" />
            <!-- Opens to the serial number and SNID, named as on the label and in Acer Care Center -->
            <toolkit:SettingsExpander
                Description="{x:Bind ViewModel.BiosVersion, Mode=OneWay}"
                Header="{x:Bind ViewModel.LaptopModel, Mode=OneWay}"
                HeaderIcon="{ui:FontIcon Glyph=&#xE7F8;}">
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard Header="SN" Visibility="{x:Bind ViewModel.HasSerialNumber, Mode=OneWay}">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.SerialNumber, Mode=OneWay}" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="SNID" Visibility="{x:Bind ViewModel.HasSnid, Mode=OneWay}">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.Snid, Mode=OneWay}" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
            <toolkit:SettingsCard
                x:Uid="Settings_Sensors"
                Description="{x:Bind ViewModel.TemperatureSources, Mode=OneWay}"
                HeaderIcon="{ui:FontIcon Glyph=&#xE9CA;}">
                <HyperlinkButton
                    x:Uid="Settings_GetPawnIO"
                    NavigateUri="https://pawnio.eu/"
                    Visibility="{x:Bind ViewModel.PawnIOMissing, Mode=OneWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard
                x:Uid="Settings_OperatingModes"
                Description="{x:Bind ViewModel.OperatingModesDescription, Mode=OneWay}"
                HeaderIcon="{ui:FontIcon Glyph=&#xE7BA;}"
                Visibility="{x:Bind ViewModel.OperatingModesSwitchAvailable, Mode=OneWay}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.OperatingModesOn, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard
                x:Uid="Settings_MagKey"
                HeaderIcon="{ui:FontIcon Glyph=&#xE765;}"
                Visibility="{x:Bind ViewModel.MagKeySwitchAvailable, Mode=OneWay}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.MagKeyOn, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <TextBlock x:Uid="Settings_Updates" Style="{StaticResource SectionHeaderStyle}" />
            <!-- Version and "Check now"; with an update found it opens downward to offer it -->
            <toolkit:SettingsCard
                Description="{x:Bind Updates.Status, Mode=OneWay}"
                Header="{x:Bind Updates.CurrentVersionText}"
                HeaderIcon="{ui:FontIcon Glyph=&#xE895;}"
                Visibility="{x:Bind Updates.NoUpdate, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing
                        Width="20"
                        Height="20"
                        IsActive="{x:Bind Updates.IsChecking, Mode=OneWay}" />
                    <Button x:Uid="Settings_CheckNow" Command="{x:Bind Updates.CheckNowCommand}" />
                </StackPanel>
            </toolkit:SettingsCard>
            <toolkit:SettingsExpander
                Description="{x:Bind Updates.Status, Mode=OneWay}"
                Header="{x:Bind Updates.CurrentVersionText}"
                HeaderIcon="{ui:FontIcon Glyph=&#xE895;}"
                IsExpanded="{x:Bind Updates.DetailsOpen, Mode=TwoWay}"
                Visibility="{x:Bind Updates.HasUpdate, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing
                        Width="20"
                        Height="20"
                        IsActive="{x:Bind Updates.IsChecking, Mode=OneWay}" />
                    <Button x:Uid="Settings_CheckNow" Command="{x:Bind Updates.CheckNowCommand}" />
                </StackPanel>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard
                        Description="{x:Bind Updates.BannerMessage, Mode=OneWay}"
                        Header="{x:Bind Updates.BannerTitle, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <HyperlinkButton x:Uid="Update_WhatsNew" Command="{x:Bind Updates.OpenReleasePageCommand}" />
                            <HyperlinkButton x:Uid="Update_Skip" Command="{x:Bind Updates.SkipCommand}" />
                            <Button
                                x:Uid="Update_Install"
                                Command="{x:Bind Updates.InstallCommand}"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch" Visibility="{x:Bind Updates.IsDownloading, Mode=OneWay}">
                        <ProgressBar Maximum="1" Value="{x:Bind Updates.DownloadProgress, Mode=OneWay}" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
            <toolkit:SettingsCard x:Uid="Settings_AutoUpdate" HeaderIcon="{ui:FontIcon Glyph=&#xE823;}">
                <ToggleSwitch IsOn="{x:Bind Updates.CheckAutomatically, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <TextBlock x:Uid="Settings_Troubleshooting" Style="{StaticResource SectionHeaderStyle}" />
            <toolkit:SettingsCard x:Uid="Settings_Diagnostics" HeaderIcon="{ui:FontIcon Glyph=&#xE9D9;}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.CopyDiagnosticsCommand}" Content="{x:Bind ViewModel.CopyText, Mode=OneWay}" />
                    <Button
                        x:Uid="Settings_ServiceLogs"
                        Command="{x:Bind ViewModel.OpenServiceLogsCommand}"
                        Visibility="{x:Bind ViewModel.HasServiceLogs, Mode=OneWay}" />
                    <Button x:Uid="Settings_AppLogs" Command="{x:Bind ViewModel.OpenAppLogsCommand}" />
                </StackPanel>
            </toolkit:SettingsCard>

            <TextBlock x:Uid="Settings_About" Style="{StaticResource SectionHeaderStyle}" />
            <toolkit:SettingsExpander
                x:Uid="Settings_AboutOpenSense"
                Header="OpenSense"
                HeaderIcon="{ui:BitmapIcon Source=ms-appx:///Assets/OpenSense.png}">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind local:SettingsPage.VersionText(ViewModel.Version)}" />
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard ContentAlignment="Left">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.ModeDescription, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard ContentAlignment="Left">
                        <TextBlock
                            x:Uid="Settings_Trademarks"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
        </StackPanel>
    </ScrollView>
</Page>

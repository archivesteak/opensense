<Page
    x:Class="OpenSense.App.Views.SystemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Padding="{StaticResource PagePadding}"
            Spacing="4">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Keyboard &amp; display" />

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Keyboard" />
            <toolkit:SettingsCard
                Description="Turn the keyboard backlight off after 30 seconds without typing."
                Header="Backlight auto-off"
                HeaderIcon="{ui:FontIcon Glyph=&#xE706;}"
                Visibility="{x:Bind ViewModel.BacklightAutoOffAvailable, Mode=OneWay}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.BacklightAutoOff, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard
                Description="Turn off to stop the Windows and Menu keys from interrupting games."
                Header="Windows and Menu keys"
                HeaderIcon="{ui:FontIcon Glyph=&#xE7FC;}"
                Visibility="{x:Bind ViewModel.WindowsKeyAvailable, Mode=OneWay}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.WindowsKey, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard
                Description="Modifier keys stay pressed after you release them; press Shift five times to toggle."
                Header="Sticky Keys"
                HeaderIcon="{ui:FontIcon Glyph=&#xE765;}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.StickyKeysOn, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.LcdOverdriveAvailable, Mode=OneWay}">
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Display" />
                <toolkit:SettingsCard
                    Description="For the laptop's built-in screen (not external monitors): faster pixel response for less motion blur in games. Works best at the screen's highest refresh rate; turn off if you see halos behind moving objects."
                    Header="LCD overdrive"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE7F4;}">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.LcdOverdrive, Mode=TwoWay}" />
                </toolkit:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.GpuSwitchAvailable, Mode=OneWay}">
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Graphics" />
                <toolkit:SettingsCard
                    Description="Hybrid saves battery by using the integrated GPU for the display. Discrete connects the NVIDIA GPU directly for the best game performance. Applies after a restart."
                    Header="GPU mode"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE7F4;}">
                    <toolkit:Segmented SelectedIndex="{x:Bind ViewModel.GpuModeIndex, Mode=TwoWay}">
                        <toolkit:SegmentedItem Content="Hybrid" />
                        <toolkit:SegmentedItem Content="Discrete" />
                    </toolkit:Segmented>
                </toolkit:SettingsCard>
                <InfoBar
                    Title="Restart to switch GPU mode"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.RestartPending, Mode=OneWay}"
                    Message="The new GPU mode takes effect after Windows restarts."
                    Severity="Informational">
                    <InfoBar.ActionButton>
                        <Button Command="{x:Bind ViewModel.RestartNowCommand}" Content="Restart now" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>

            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.PowerPlansAvailable, Mode=OneWay}">
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Power" />
                <toolkit:SettingsCard
                    Description="The Windows power plan in use."
                    Header="Power plan"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE945;}">
                    <ComboBox
                        MinWidth="220"
                        DisplayMemberPath="Name"
                        ItemsSource="{x:Bind ViewModel.PowerPlans}"
                        SelectedItem="{x:Bind ViewModel.SelectedPowerPlan, Mode=TwoWay}" />
                </toolkit:SettingsCard>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

<Page
    x:Class="OpenSense.App.Views.LightingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OpenSense.App.Controls"
    xmlns:local="using:OpenSense.App.Views"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:OpenSense.App.ViewModels"
    xmlns:wui="using:Windows.UI"
    NavigationCacheMode="Required">

    <Page.Resources>
        <DataTemplate x:Key="SwatchTemplate" x:DataType="wui:Color">
            <Button
                Width="30"
                Height="30"
                Click="OnSwatchClick"
                CornerRadius="15"
                Style="{StaticResource ColorButtonStyle}"
                Tag="{x:Bind}">
                <Button.Background>
                    <SolidColorBrush Color="{x:Bind}" />
                </Button.Background>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <ScrollView>
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Padding="{StaticResource PagePadding}"
            Spacing="16">
            <TextBlock x:Uid="Lighting_Title" Style="{StaticResource PageTitleStyle}" />

            <!-- One light at a time; the bar is filled from ViewModel.Devices in code-behind. -->
            <SelectorBar
                x:Name="DeviceBar"
                Margin="-12,-8,0,0"
                SelectionChanged="OnDeviceSelected"
                Visibility="{x:Bind ViewModel.HasSeveralDevices, Mode=OneWay}" />

            <!-- Preview + brightness -->
            <Border Padding="24" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="20">
                    <controls:KeyboardPreview
                        Height="230"
                        Revision="{x:Bind ViewModel.PreviewRevision, Mode=OneWay}"
                        Source="{x:Bind ViewModel}"
                        Visibility="{x:Bind ViewModel.IsKeyboard, Mode=OneWay}" />
                    <controls:LightBarPreview
                        Height="120"
                        Revision="{x:Bind ViewModel.PreviewRevision, Mode=OneWay}"
                        Source="{x:Bind ViewModel}"
                        Visibility="{x:Bind ViewModel.IsLightBar, Mode=OneWay}" />
                    <controls:LogoPreview
                        Height="180"
                        Revision="{x:Bind ViewModel.PreviewRevision, Mode=OneWay}"
                        Source="{x:Bind ViewModel}"
                        Visibility="{x:Bind ViewModel.IsLogo, Mode=OneWay}" />
                    <!-- Keyboards with a light per key: the preview is also where keys are picked -->
                    <controls:PerKeyKeyboard
                        Height="260"
                        Revision="{x:Bind ViewModel.PreviewRevision, Mode=OneWay}"
                        Source="{x:Bind ViewModel}"
                        Visibility="{x:Bind ViewModel.HasKeys, Mode=OneWay}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE706;" />
                        <toolkit:Segmented
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.BrightnessNames, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.BrightnessIndex, Mode=TwoWay}" />
                    </Grid>
                    <Button
                        x:Uid="Lighting_ApplyToAll"
                        HorizontalAlignment="Right"
                        Command="{x:Bind ViewModel.ApplyToAllCommand}"
                        Visibility="{x:Bind ViewModel.HasSeveralDevices, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <toolkit:Segmented
                HorizontalAlignment="Stretch"
                SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.HasModes, Mode=OneWay}">
                <toolkit:SegmentedItem x:Uid="Lighting_Static">
                    <toolkit:SegmentedItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </toolkit:SegmentedItem.Icon>
                </toolkit:SegmentedItem>
                <toolkit:SegmentedItem x:Uid="Lighting_Effect" Visibility="{x:Bind ViewModel.HasEffects, Mode=OneWay}">
                    <toolkit:SegmentedItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </toolkit:SegmentedItem.Icon>
                </toolkit:SegmentedItem>
                <toolkit:SegmentedItem x:Uid="Lighting_PerKey" Visibility="{x:Bind ViewModel.HasPerKey, Mode=OneWay}">
                    <toolkit:SegmentedItem.Icon>
                        <FontIcon Glyph="&#xE765;" />
                    </toolkit:SegmentedItem.Icon>
                </toolkit:SegmentedItem>
            </toolkit:Segmented>

            <!-- A colour per key -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsPerKey, Mode=OneWay}">
                <StackPanel Spacing="14">
                    <TextBlock
                        x:Uid="Lighting_PerKeyHint"
                        Style="{StaticResource CaptionMutedStyle}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Uid="Lighting_SelectWasd"
                            Command="{x:Bind ViewModel.SelectKeysCommand}"
                            CommandParameter="wasd" />
                        <Button
                            x:Uid="Lighting_SelectArrows"
                            Command="{x:Bind ViewModel.SelectKeysCommand}"
                            CommandParameter="arrows" />
                        <Button
                            x:Uid="Lighting_SelectFunctionKeys"
                            Command="{x:Bind ViewModel.SelectKeysCommand}"
                            CommandParameter="functions" />
                        <Button
                            x:Uid="Lighting_SelectNumbers"
                            Command="{x:Bind ViewModel.SelectKeysCommand}"
                            CommandParameter="numbers" />
                        <Button
                            x:Uid="Lighting_SelectAll"
                            Command="{x:Bind ViewModel.SelectKeysCommand}"
                            CommandParameter="all" />
                        <Button
                            x:Uid="Lighting_SelectNone"
                            Command="{x:Bind ViewModel.ClearKeySelectionCommand}"
                            IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ItemsRepeater ItemTemplate="{StaticResource SwatchTemplate}" ItemsSource="{x:Bind vm:LightingViewModel.Swatches}" Tag="keys">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="10" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                        <Button
                            x:Uid="Lighting_AnyColor"
                            Width="30"
                            Height="30"
                            Padding="0"
                            CornerRadius="15">
                            <FontIcon FontSize="12" Glyph="&#xE710;" />
                            <Button.Flyout>
                                <Flyout>
                                    <ColorPicker
                                        ColorSpectrumShape="Ring"
                                        IsAlphaEnabled="False"
                                        IsColorChannelTextInputVisible="True"
                                        IsHexInputVisible="True"
                                        IsMoreButtonVisible="False"
                                        Color="{x:Bind ViewModel.KeysColor, Mode=TwoWay}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Uid="Lighting_TurnOffKeys" Command="{x:Bind ViewModel.TurnOffKeysCommand}" />
                    </StackPanel>
                    <ComboBox
                        x:Uid="Lighting_Layout"
                        MinWidth="220"
                        ItemsSource="{x:Bind ViewModel.LayoutNames}"
                        SelectedIndex="{x:Bind ViewModel.LayoutIndex, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.LayoutChoice, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Static zones -->
            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsStatic, Mode=OneWay}">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Zones}" Visibility="{x:Bind ViewModel.HasZones, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MaximumRowsOrColumns="{x:Bind local:LightingPage.ZoneColumns(ViewModel.Zones.Count), Mode=OneWay}"
                            MinColumnSpacing="12"
                            MinItemWidth="200"
                            MinRowSpacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:ZoneViewModel">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Name}" />
                                        <ToggleSwitch
                                            MinWidth="0"
                                            HorizontalAlignment="Right"
                                            IsOn="{x:Bind On, Mode=TwoWay}"
                                            OffContent=""
                                            OnContent=""
                                            Visibility="{x:Bind Switchable}" />
                                    </Grid>
                                    <Button
                                        x:Uid="Lighting_ZoneColor"
                                        Height="44"
                                        HorizontalAlignment="Stretch"
                                        CornerRadius="8"
                                        IsEnabled="{x:Bind On, Mode=OneWay}"
                                        Style="{StaticResource ColorButtonStyle}">
                                        <Button.Background>
                                            <SolidColorBrush Color="{x:Bind ShownColor, Mode=OneWay}" />
                                        </Button.Background>
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker
                                                    ColorSpectrumShape="Ring"
                                                    IsAlphaEnabled="False"
                                                    IsColorChannelTextInputVisible="True"
                                                    IsHexInputVisible="True"
                                                    IsMoreButtonVisible="False"
                                                    Color="{x:Bind Color, Mode=TwoWay}" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock
                            x:Uid="Lighting_AllZones"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Visibility="{x:Bind ViewModel.HasZones, Mode=OneWay}" />
                        <TextBlock
                            x:Uid="Lighting_Color"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Visibility="{x:Bind ViewModel.IsSingleColor, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ItemsRepeater ItemTemplate="{StaticResource SwatchTemplate}" ItemsSource="{x:Bind vm:LightingViewModel.Swatches}" Tag="all">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="10" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                            <Button
                                x:Uid="Lighting_AnyColor"
                                Width="30"
                                Height="30"
                                Padding="0"
                                CornerRadius="15">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                <Button.Flyout>
                                    <Flyout>
                                        <ColorPicker
                                            ColorSpectrumShape="Ring"
                                            IsAlphaEnabled="False"
                                            IsColorChannelTextInputVisible="True"
                                            IsHexInputVisible="True"
                                            IsMoreButtonVisible="False"
                                            Color="{x:Bind ViewModel.AllZonesColor, Mode=TwoWay}" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Effects -->
            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsEffect, Mode=OneWay}">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Uid="Lighting_EffectList"
                                MinWidth="220"
                                VerticalAlignment="Center"
                                ItemsSource="{x:Bind ViewModel.Effects, Mode=OneWay}"
                                SelectedIndex="{x:Bind ViewModel.EffectIndex, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EffectOption">
                                        <TextBlock Text="{x:Bind Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionMutedStyle}"
                                Text="{x:Bind ViewModel.EffectDescription, Mode=OneWay}" />
                        </Grid>

                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Slider
                                x:Uid="Lighting_Speed"
                                Maximum="{x:Bind ViewModel.SpeedMaximum, Mode=OneWay}"
                                Minimum="{x:Bind ViewModel.SpeedMinimum, Mode=OneWay}"
                                StepFrequency="1"
                                TickFrequency="1"
                                TickPlacement="Outside"
                                Visibility="{x:Bind ViewModel.EffectUsesSpeed, Mode=OneWay}"
                                Value="{x:Bind ViewModel.Speed, Mode=TwoWay}" />
                            <StackPanel
                                Grid.Column="1"
                                Spacing="6"
                                Visibility="{x:Bind ViewModel.EffectUsesDirection, Mode=OneWay}">
                                <TextBlock x:Uid="Lighting_Direction" />
                                <toolkit:Segmented
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind ViewModel.Directions, Mode=OneWay}"
                                    SelectedIndex="{x:Bind ViewModel.DirectionIndex, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.EffectUsesColor, Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock
                                x:Uid="Lighting_EffectColor"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <CheckBox
                                x:Uid="Lighting_RandomColor"
                                MinWidth="0"
                                HorizontalAlignment="Right"
                                IsChecked="{x:Bind ViewModel.RandomColor, Mode=TwoWay}"
                                Visibility="{x:Bind ViewModel.EffectTakesRandomColor, Mode=OneWay}" />
                        </Grid>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="10"
                            Visibility="{x:Bind ViewModel.EffectColorChosen, Mode=OneWay}">
                            <ItemsRepeater ItemTemplate="{StaticResource SwatchTemplate}" ItemsSource="{x:Bind vm:LightingViewModel.Swatches}" Tag="effect">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="10" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                            <Button
                                x:Uid="Lighting_AnyColor"
                                Width="30"
                                Height="30"
                                Padding="0"
                                CornerRadius="15">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                <Button.Flyout>
                                    <Flyout>
                                        <ColorPicker
                                            ColorSpectrumShape="Ring"
                                            IsAlphaEnabled="False"
                                            IsColorChannelTextInputVisible="True"
                                            IsHexInputVisible="True"
                                            IsMoreButtonVisible="False"
                                            Color="{x:Bind ViewModel.EffectColor, Mode=TwoWay}" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollView>
</Page>

<Page
    x:Class="OpenSense.App.Views.LightingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OpenSense.App.Controls"
    xmlns:local="using:OpenSense.App.Views"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:OpenSense.App.ViewModels"
    xmlns:wui="using:Windows.UI"
    NavigationCacheMode="Required">

    <Page.Resources>
        <DataTemplate x:Key="SwatchTemplate" x:DataType="wui:Color">
            <Button
                Width="30"
                Height="30"
                Click="OnSwatchClick"
                CornerRadius="15"
                Style="{StaticResource ColorButtonStyle}"
                Tag="{x:Bind}">
                <Button.Background>
                    <SolidColorBrush Color="{x:Bind}" />
                </Button.Background>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <ScrollView>
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Padding="{StaticResource PagePadding}"
            Spacing="16">
            <TextBlock x:Uid="Lighting_Title" Style="{StaticResource PageTitleStyle}" />

            <!-- Preview + brightness -->
            <Border Padding="24" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="20">
                    <controls:KeyboardPreview
                        Height="230"
                        Revision="{x:Bind ViewModel.PreviewRevision, Mode=OneWay}"
                        Source="{x:Bind ViewModel}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE706;" />
                        <toolkit:Segmented
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind vm:LightingViewModel.BrightnessNames}"
                            SelectedIndex="{x:Bind ViewModel.BrightnessIndex, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <toolkit:Segmented
                HorizontalAlignment="Stretch"
                SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}">
                <toolkit:SegmentedItem x:Uid="Lighting_Static">
                    <toolkit:SegmentedItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </toolkit:SegmentedItem.Icon>
                </toolkit:SegmentedItem>
                <toolkit:SegmentedItem x:Uid="Lighting_Effect">
                    <toolkit:SegmentedItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </toolkit:SegmentedItem.Icon>
                </toolkit:SegmentedItem>
            </toolkit:Segmented>

            <!-- Static zones -->
            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsStatic, Mode=OneWay}">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Zones}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MaximumRowsOrColumns="{x:Bind local:LightingPage.ZoneColumns(ViewModel.Zones.Count), Mode=OneWay}"
                            MinColumnSpacing="12"
                            MinItemWidth="200"
                            MinRowSpacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:ZoneViewModel">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Name}" />
                                        <ToggleSwitch
                                            MinWidth="0"
                                            HorizontalAlignment="Right"
                                            IsOn="{x:Bind On, Mode=TwoWay}"
                                            OffContent=""
                                            OnContent="" />
                                    </Grid>
                                    <Button
                                        x:Uid="Lighting_ZoneColor"
                                        Height="44"
                                        HorizontalAlignment="Stretch"
                                        CornerRadius="8"
                                        IsEnabled="{x:Bind On, Mode=OneWay}"
                                        Style="{StaticResource ColorButtonStyle}">
                                        <Button.Background>
                                            <SolidColorBrush Color="{x:Bind Color, Mode=OneWay}" />
                                        </Button.Background>
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker
                                                    ColorSpectrumShape="Ring"
                                                    IsAlphaEnabled="False"
                                                    IsColorChannelTextInputVisible="True"
                                                    IsHexInputVisible="True"
                                                    IsMoreButtonVisible="False"
                                                    Color="{x:Bind Color, Mode=TwoWay}" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="Lighting_AllZones" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ItemsRepeater ItemTemplate="{StaticResource SwatchTemplate}" ItemsSource="{x:Bind vm:LightingViewModel.Swatches}" Tag="all">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="10" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                            <Button
                                x:Uid="Lighting_AnyColor"
                                Width="30"
                                Height="30"
                                Padding="0"
                                CornerRadius="15">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                <Button.Flyout>
                                    <Flyout>
                                        <ColorPicker
                                            ColorSpectrumShape="Ring"
                                            IsAlphaEnabled="False"
                                            IsColorChannelTextInputVisible="True"
                                            IsHexInputVisible="True"
                                            IsMoreButtonVisible="False"
                                            Color="{x:Bind ViewModel.AllZonesColor, Mode=TwoWay}" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Effects -->
            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsEffect, Mode=OneWay}">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <toolkit:Segmented
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind vm:LightingViewModel.Effects}"
                            SelectedIndex="{x:Bind ViewModel.EffectIndex, Mode=TwoWay}">
                            <toolkit:Segmented.ItemTemplate>
                                <DataTemplate x:DataType="vm:EffectOption">
                                    <TextBlock Text="{x:Bind Name}" />
                                </DataTemplate>
                            </toolkit:Segmented.ItemTemplate>
                        </toolkit:Segmented>
                        <TextBlock Style="{StaticResource CaptionMutedStyle}" Text="{x:Bind ViewModel.EffectDescription, Mode=OneWay}" />

                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Slider
                                x:Uid="Lighting_Speed"
                                Maximum="9"
                                Minimum="1"
                                StepFrequency="1"
                                TickFrequency="1"
                                TickPlacement="Outside"
                                Value="{x:Bind ViewModel.Speed, Mode=TwoWay}" />
                            <StackPanel
                                Grid.Column="1"
                                Spacing="6"
                                Visibility="{x:Bind ViewModel.EffectUsesDirection, Mode=OneWay}">
                                <TextBlock x:Uid="Lighting_Direction" />
                                <toolkit:Segmented
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind vm:LightingViewModel.Directions}"
                                    SelectedIndex="{x:Bind ViewModel.DirectionIndex, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.EffectUsesColor, Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="Lighting_EffectColor" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ItemsRepeater ItemTemplate="{StaticResource SwatchTemplate}" ItemsSource="{x:Bind vm:LightingViewModel.Swatches}" Tag="effect">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="10" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                            <Button
                                x:Uid="Lighting_AnyColor"
                                Width="30"
                                Height="30"
                                Padding="0"
                                CornerRadius="15">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                <Button.Flyout>
                                    <Flyout>
                                        <ColorPicker
                                            ColorSpectrumShape="Ring"
                                            IsAlphaEnabled="False"
                                            IsColorChannelTextInputVisible="True"
                                            IsHexInputVisible="True"
                                            IsMoreButtonVisible="False"
                                            Color="{x:Bind ViewModel.EffectColor, Mode=TwoWay}" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollView>
</Page>

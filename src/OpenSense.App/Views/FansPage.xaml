<Page
    x:Class="OpenSense.App.Views.FansPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OpenSense.App.Controls"
    xmlns:helpers="using:OpenSense.App.Helpers"
    xmlns:local="using:OpenSense.App.Views"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:OpenSense.App.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- Presets: in the header of a curve card -->
        <DataTemplate x:Key="CurveToolbarTemplate" x:DataType="vm:CurveFanViewModel">
            <DropDownButton x:Uid="Fans_Presets">
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem x:Uid="Fans_PresetDefault" Command="{x:Bind ApplyDefaultCommand}" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </DataTemplate>

        <!-- Temperature → boost -->
        <DataTemplate x:Key="CurveEditorTemplate" x:DataType="vm:CurveFanViewModel">
            <StackPanel Spacing="12">
                <controls:FanCurveEditor
                    Height="300"
                    Curve="{x:Bind Curve, Mode=TwoWay}"
                    LivePercent="{x:Bind LivePercent, Mode=OneWay}"
                    LiveTemperature="{x:Bind LiveTemperature, Mode=OneWay}"
                    UseFahrenheit="{x:Bind UseFahrenheit, Mode=OneWay}" />
                <TextBlock x:Uid="Fans_CurveHelp" Style="{StaticResource CaptionMutedStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollView>
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Padding="{StaticResource PagePadding}"
            Spacing="16">
            <TextBlock x:Uid="Fans_Title" Style="{StaticResource PageTitleStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <toolkit:Segmented
                        HorizontalAlignment="Stretch"
                        IsEnabled="{x:Bind Fans.HasFans, Mode=OneWay}"
                        ItemsSource="{x:Bind vm:FanControlViewModel.ModeNames}"
                        SelectedIndex="{x:Bind Fans.ModeIndex, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource CaptionMutedStyle}" Text="{x:Bind Fans.ModeDescription, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{x:Bind Monitor.Fans}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:TileGrid MinColumnWidth="260" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FanReadingViewModel">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                    <TextBlock Style="{StaticResource CaptionMutedStyle}" Text="{x:Bind BehaviorText, Mode=OneWay}" />
                                </StackPanel>
                                <controls:FanRotor
                                    Height="200"
                                    Boost="{x:Bind local:FansPage.BoostValue(Boost), Mode=OneWay}"
                                    Rpm="{x:Bind local:FansPage.RpmValue(Rpm), Mode=OneWay}" />
                                <TextBlock HorizontalAlignment="Center">
                                    <Run
                                        FontFamily="Segoe UI Variable Display"
                                        FontSize="32"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind helpers:Units.RpmNumber(Rpm), Mode=OneWay}" />
                                    <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind helpers:Units.RpmSuffix}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind Fans.IsLocked, Mode=OneWay}"
                Visibility="{x:Bind Fans.IsLocked, Mode=OneWay}"
                Message="{x:Bind Fans.LockReason, Mode=OneWay}"
                Severity="Informational" />

            <!-- Auto: the firmware, boosted along a fixed curve when it gets hot -->
            <toolkit:SettingsCard
                x:Uid="Fans_AutoBoost"
                HeaderIcon="{ui:FontIcon Glyph=&#xEA18;}"
                Visibility="{x:Bind Fans.IsAuto, Mode=OneWay}">
                <ToggleSwitch IsOn="{x:Bind Fans.AutoBoostEnabled, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <!-- CoolBoost raises the firmware's own speed: Auto uses it, Custom adds to it -->
            <toolkit:SettingsCard
                x:Uid="Fans_CoolBoost"
                Header="CoolBoost"
                HeaderIcon="{ui:FontIcon Glyph=&#xE9CA;}"
                Visibility="{x:Bind Fans.ShowCoolBoost, Mode=OneWay}">
                <ToggleSwitch IsOn="{x:Bind Fans.CoolBoost, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <!-- Custom: per fan, a fixed boost or a curve -->
            <ItemsControl ItemsSource="{x:Bind Fans.ManualFans}" Visibility="{x:Bind Fans.IsCustom, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="16" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ManualFanViewModel">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="{x:Bind Name}" />
                                    <ContentControl
                                        Grid.Column="1"
                                        Content="{x:Bind Curve}"
                                        ContentTemplate="{StaticResource CurveToolbarTemplate}"
                                        Visibility="{x:Bind UseCurve, Mode=OneWay}" />
                                    <toolkit:Segmented Grid.Column="2" SelectedIndex="{x:Bind KindIndex, Mode=TwoWay}">
                                        <toolkit:SegmentedItem x:Uid="Fans_BoostFixed" />
                                        <toolkit:SegmentedItem x:Uid="Fans_BoostCurve" />
                                    </toolkit:Segmented>
                                </Grid>
                                <StackPanel Spacing="12" Visibility="{x:Bind IsFixed, Mode=OneWay}">
                                    <TextBlock Style="{StaticResource BigNumberStyle}" Text="{x:Bind PercentText, Mode=OneWay}" />
                                    <Slider
                                        x:Uid="Fans_Boost"
                                        Maximum="100"
                                        Minimum="0"
                                        StepFrequency="5"
                                        TickFrequency="10"
                                        TickPlacement="Outside"
                                        Value="{x:Bind Percent, Mode=TwoWay}" />
                                </StackPanel>
                                <ContentControl
                                    HorizontalContentAlignment="Stretch"
                                    Content="{x:Bind Curve}"
                                    ContentTemplate="{StaticResource CurveEditorTemplate}"
                                    Visibility="{x:Bind UseCurve, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Uid="Fans_Safety" Style="{StaticResource SectionHeaderStyle}" />
            <toolkit:SettingsCard x:Uid="Fans_HandBack" HeaderIcon="{ui:FontIcon Glyph=&#xE7E8;}">
                <ToggleSwitch IsOn="{x:Bind Fans.RestoreAutoOnExit, Mode=TwoWay}" />
            </toolkit:SettingsCard>
        </StackPanel>
    </ScrollView>
</Page>

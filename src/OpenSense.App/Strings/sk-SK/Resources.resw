  </data>
  <data name="Fans_CoolBoost.Description" xml:space="preserve">
    <value>Zvyšuje vlastné otáčky ventilátorov riadené firmvérom, ktoré používa režim Auto a ku ktorým režim Ručný pridáva.</value>

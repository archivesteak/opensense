    <value>Všetky ventilátory na plné otáčky.</value>
  </data>
  <data name="FanMode_Custom_Description" xml:space="preserve">
    <value>Otáčky pridané k otáčkam firmvéru pre každý ventilátor, pevne alebo podľa krivky. 0 % nechá ventilátor na firmvéri, 100 % sú plné otáčky.</value>
  </data>

  <data name="GpuSwitch_HybridTitle" xml:space="preserve">
    <value>Prepnúť na hybridnú grafiku?</value>
    <comment>Dialog title.</comment>
  </data>
  <data name="GpuSwitch_DiscreteMessage" xml:space="preserve">
    <value>GPU NVIDIA bude priamo ovládať obrazovku, čo zabezpečí najvyšší herný výkon na úkor výdrže batérie. Na uplatnenie zmeny sa musí Windows reštartovať.</value>
  </data>
  <data name="GpuSwitch_HybridMessage" xml:space="preserve">
    <value>Obrazovku bude ovládať integrovaný GPU a samostatný GPU sa zapne len v prípade potreby, čo šetrí batériu. Na uplatnenie zmeny sa musí Windows reštartovať.</value>
  </data>
  <data name="GpuSwitch_RestartNow" xml:space="preserve">
    <value>Reštartovať teraz</value>
    <comment>Dialog button: restart Windows now.</comment>
  </data>
  <data name="GpuSwitch_RestartLater" xml:space="preserve">
    <value>Reštartovať neskôr</value>
    <comment>Dialog button.</comment>
  </data>
  <data name="GpuSwitch_Cancel" xml:space="preserve">
    <value>Zrušiť</value>
    <comment>Dialog button.</comment>
  </data>

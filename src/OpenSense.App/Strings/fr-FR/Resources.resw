  <data name="Lighting_AllZones.Text" xml:space="preserve">
    <value>Une seule couleur pour toutes les zones</value>
  </data>
  <data name="Lighting_Speed.Header" xml:space="preserve">
    <value>Vitesse</value>
    <comment>Slider label: animation speed.</comment>
  </data>
  <data name="Lighting_Direction.Text" xml:space="preserve">
    <value>Direction</value>
    <comment>Label: animation direction.</comment>
  </data>
  <data name="Lighting_EffectColor.Text" xml:space="preserve">
    <value>Couleur de l’effet</value>
  </data>

    <value>Usar imagen</value>
    <comment>The dialog's button that makes the picture the boot logo.</comment>
  </data>
  <data name="BootLogo_NotGifOrJpeg" xml:space="preserve">
    <value>Elige una imagen GIF o JPEG.</value>
  </data>
  <data name="BootLogo_FileTooLarge" xml:space="preserve">

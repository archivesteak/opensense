    <value>Wentylator CPU</value>
  </data>
  <data name="Fan_Gpu" xml:space="preserve">
    <value>Wentylator GPU</value>
  </data>
  <data name="Fan_Gpu1" xml:space="preserve">
    <value>Wentylator GPU 1</value>

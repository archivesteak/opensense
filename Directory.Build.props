<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Version>0.2.0</Version>
    <Authors>OpenSense contributors</Authors>
    <Product>OpenSense</Product>
    <Copyright>OpenSense contributors</Copyright>
    <!-- Also where the app looks for updates (GitHub Releases). -->
    <RepositoryUrl>https://github.com/archivesteak/opensense</RepositoryUrl>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
